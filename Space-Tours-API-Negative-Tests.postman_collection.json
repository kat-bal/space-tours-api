          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var baseUrl = pm.environment.get('base_url');",
                  "",
                  "pm.sendRequest({",
                  "    url: baseUrl + '/bookings',",
                  "    method: 'POST',",
                  "    header: [{ key: 'Content-Type', value: 'application/json' }],",
                  "    body: {",
                  "        mode: 'raw',",
                  "        raw: JSON.stringify({",
                  "            passenger: { first_name: 'Cancel', last_name: 'Setup-A' },",
                  "            destination: 'Venus',",
                  "            departure_date: '2029-08-01',",
                  "            seat_class: 'economy'",
                  "        })",
                  "    }",
                  "}, function (err, res) {",
                  "    var id = res.json().id;",
                  "    pm.sendRequest({",
                  "        url: baseUrl + '/bookings/' + id,",
                  "        method: 'PUT',",
                  "        header: [{ key: 'Content-Type', value: 'application/json' }],",
                  "        body: { mode: 'raw', raw: JSON.stringify({ status: 'cancelled' }) }",
                  "    }, function (err2, res2) {",
                  "        pm.environment.set('cancelled_id_a', id);",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
