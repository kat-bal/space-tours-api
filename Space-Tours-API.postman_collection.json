{
  "info": {
    "_postman_id": "3d6e80a0-6ca2-40ca-b8ca-443b738c1a1e",
    "name": "Space-Tours-API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "18266109"
  },
  "item": [
    {
      "name": "Health-Check",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('API is online', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.status).to.eql('online');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/"
      },
      "response": []
    },
    {
      "name": "Get-Destinations",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Returns array of destinations', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json).to.be.an('array');",
              "    pm.expect(json.length).to.be.above(0);",
              "});",
              "pm.test('Each destination has required fields', function () {",
              "    var json = pm.response.json();",
              "    json.forEach(function(dest) {",
              "        pm.expect(dest).to.have.property('name');",
              "        pm.expect(dest).to.have.property('price_usd');",
              "        pm.expect(dest).to.have.property('duration_days');",
              "    });",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/destinations"
      },
      "response": []
    },
    {
      "name": "Create-Booking",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test('Response contains booking ID', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json).to.have.property('id');",
              "    pm.environment.set('booking_id', json.id);",
              "});",
              "pm.test('Status is pending', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.status).to.eql('pending');",
              "});",
              "pm.test('Destination matches request', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.destination).to.eql('Jupiter');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"passenger_name\": \"Stratus Hypert\",\n  \"destination\": \"Jupiter\",\n  \"departure_date\": \"2027-02-02\",\n  \"seat_class\": \"business\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/bookings"
      },
      "response": []
    },
    {
      "name": "Get-All-Bookings",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Returns array', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json).to.be.an('array');",
              "});",
              "pm.test('Each booking has required fields', function () {",
              "    var json = pm.response.json();",
              "    json.forEach(function(booking) {",
              "        pm.expect(booking).to.have.property('id');",
              "        pm.expect(booking).to.have.property('passenger_name');",
              "        pm.expect(booking).to.have.property('destination');",
              "        pm.expect(booking).to.have.property('status');",
              "    });",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/bookings",
          "query": [
            {
              "key": "destination",
              "value": "Saturn",
              "description": "Mercury, Venus, Mars, Jupiter, Saturn, Uranus, Neptune",
              "disabled": true
            },
            {
              "key": "status",
              "value": "pending",
              "description": "pending, confirmed, cancelled",
              "disabled": true
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get-Booking-By-ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Returns booking object (not null)', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json).to.not.be.null;",
              "    pm.expect(json).to.have.property('id');",
              "});",
              "pm.test('ID matches requested ID', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.id).to.eql(Number(pm.variables.get('booking_id')));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/bookings/{{booking_id}}"
      },
      "response": []
    },
    {
      "name": "Update-Booking",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Status was updated to cancelled', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.status).to.eql('cancelled');",
              "});",
              "pm.test('ID matches requested ID', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.id).to.eql(Number(pm.variables.get('booking_id')));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"cancelled\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/bookings/{{booking_id}}"
      },
      "response": []
    },
    {
      "name": "Delete-Booking",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Response confirms deletion', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json).to.have.property('deleted_id');",
              "    pm.expect(json.deleted_id).to.eql(Number(pm.variables.get('booking_id')));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{base_url}}/bookings/{{booking_id}}"
      },
      "response": []
    }
  ]
}
