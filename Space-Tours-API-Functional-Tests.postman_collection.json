    {
      "name": "GET /bookings — {id}",
      "item": [
        {
          "name": "Get booking by ID — existing booking",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.sendRequest({",
                  "    url: pm.environment.get('base_url') + '/bookings',",
                  "    method: 'POST',",
                  "    header: [{ key: 'Content-Type', value: 'application/json' }],",
                  "    body: {",
                  "        mode: 'raw',",
                  "        raw: JSON.stringify({",
                  "            passenger: { first_name: 'Neil', last_name: 'Armstrong' },",
                  "            destination: 'Jupiter',",
                  "            departure_date: '2029-07-20',",
                  "            seat_class: 'vip'",
                  "        })",
                  "    }",
                  "}, function (err, res) {",
                  "    pm.environment.set('func_get_id', res.json().id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('ID matches requested ID', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.id).to.eql(Number(pm.environment.get('func_get_id')));",
                  "});",
                  "pm.test('Response has required fields', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('passenger');",
                  "    pm.expect(json).to.have.property('destination');",
                  "    pm.expect(json).to.have.property('status');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
