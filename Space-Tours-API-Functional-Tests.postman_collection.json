  "item": [
    {
      "name": "POST /bookings",
      "item": [
        {
          "name": "Create booking — valid request",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Response contains booking ID', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('id');",
                  "    pm.environment.set('func_booking_id', json.id);",
                  "});",
                  "pm.test('Status is pending', function () {",
                  "    pm.expect(pm.response.json().status).to.eql('pending');",
                  "});",
                  "pm.test('Passenger data matches request', function () {",
                  "    var p = pm.response.json().passenger;",
                  "    pm.expect(p.first_name).to.eql('Yuri');",
                  "    pm.expect(p.last_name).to.eql('Gagarin');",
                  "});",
                  "pm.test('Destination matches request', function () {",
                  "    pm.expect(pm.response.json().destination).to.eql('Mars');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"passenger\": { \"first_name\": \"Yuri\", \"last_name\": \"Gagarin\" },\n  \"destination\": \"Mars\",\n  \"departure_date\": \"2029-07-04\",\n  \"seat_class\": \"business\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/bookings"
          },
          "response": []
        },
