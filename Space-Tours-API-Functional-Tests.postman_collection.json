                  "pm.test('Error list contains 3 missing fields', function () {",
                  "    var detail = pm.response.json().detail;",
                  "    pm.expect(detail).to.be.an('array');",
                  "    pm.expect(detail.length).to.eql(3);",
                  "});",
                  "pm.test('All errors are Field required', function () {",
                  "    pm.response.json().detail.forEach(function (e) {",
                  "        pm.expect(e.msg).to.eql('Field required');",
                  "    });",
                  "});",
                  "pm.test('Errors cover passenger, destination, departure_date', function () {",
                  "    var fields = pm.response.json().detail.map(function (e) { return e.loc[1]; });",
