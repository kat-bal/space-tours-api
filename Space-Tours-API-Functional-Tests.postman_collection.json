              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response has pagination structure', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('items');",
                  "    pm.expect(json).to.have.property('total');",
                  "    pm.expect(json).to.have.property('page');",
                  "    pm.expect(json).to.have.property('pages');",
                  "    pm.expect(json.items).to.be.an('array');",
                  "});",
                  "pm.test('Page is 1 by default', function () {",
                  "    pm.expect(pm.response.json().page).to.eql(1);",
                  "});"
                ],
